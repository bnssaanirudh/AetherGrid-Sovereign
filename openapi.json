{
  "openapi": "3.1.0",
  "info": {
    "title": "AetherGrid-Sovereign API",
    "description": "Operational API platform for the AetherGrid-Sovereign cascade prediction system.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "System Status"
        ],
        "summary": "Health Check",
        "description": "Returns general service health.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/readiness": {
      "get": {
        "tags": [
          "System Status"
        ],
        "summary": "Readiness Check",
        "description": "Returns detailed readyness including dependencies status.",
        "operationId": "readiness_check_api_v1_readiness_get",
