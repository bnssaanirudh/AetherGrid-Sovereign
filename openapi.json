          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterModelPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Register Model Api V1 Models Register Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/models/approve/{model_id}": {
      "post": {
        "tags": [
          "Model Serving"
        ],
        "summary": "Approve Model",
        "description": "Approves a model artifact, setting it as active. Demotes the previous active model.",
        "operationId": "approve_model_api_v1_models_approve__model_id__post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Approve Model Api V1 Models Approve  Model Id  Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/rollback": {
      "post": {
        "tags": [
          "Model Serving"
        ],
        "summary": "Rollback Model",
        "description": "Rolls back the active model to the previous approved/archived model artifact.",
        "operationId": "rollback_model_api_v1_models_rollback_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Rollback Model Api V1 Models Rollback Post"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/models/active": {
      "get": {
        "tags": [
          "Model Serving"
        ],
        "summary": "Get Active Model",
        "description": "Retrieves metadata of the currently active model.",
        "operationId": "get_active_model_api_v1_models_active_get",
