    "/api/v1/admin/audit": {
      "get": {
        "tags": [
          "Administrative Operations"
        ],
        "summary": "Get Audit Logs",
        "description": "Retrieves append-only operational audit trails.",
        "operationId": "get_audit_logs_api_v1_admin_audit_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Get Audit Logs Api V1 Admin Audit Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/keys/rotate": {
      "post": {
        "tags": [
          "Administrative Operations"
        ],
        "summary": "Rotate Api Key",
        "description": "Rotates API access credentials.",
        "operationId": "rotate_api_key_api_v1_admin_keys_rotate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyRotationPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Rotate Api Key Api V1 Admin Keys Rotate Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestPayload": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id",
            "description": "Stable unique ID for idempotency"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type",
            "description": "E.g., sensor_reading, trigger_event",
            "default": "sensor_reading"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "Actual record attributes matching schemas"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "data"
        ],
        "title": "IngestPayload"
      },
      "KeyRotationPayload": {
        "properties": {
          "old_key": {
            "type": "string",
            "title": "Old Key",
            "description": "Key to revoke"
          },
          "new_key": {
            "type": "string",
            "title": "New Key",
            "description": "New key to register"
          }
        },
        "type": "object",
        "required": [
          "old_key",
          "new_key"
        ],
        "title": "KeyRotationPayload"
      },
      "RegisterModelPayload": {
        "properties": {
          "model_id": {
            "type": "string",
            "title": "Model Id",
            "description": "Unique model identifier"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Semantic version string"
          },
          "checksum": {
            "type": "string",
            "title": "Checksum",
            "description": "SHA-256 checksum of model artifact"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config",
            "description": "Architecture parameters"
          }
        },
        "type": "object",
        "required": [
          "model_id",
          "version",
          "checksum",
          "config"
        ],
        "title": "RegisterModelPayload"
      },
      "ScenarioPayload": {
        "properties": {
          "trigger_nodes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Trigger Nodes",
            "description": "Target node IDs to fail"
          },
          "hazard_intensity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Hazard Intensity",
            "default": 0.8
          },
          "sensor_dropout": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Sensor Dropout",
            "default": 0.0
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "trigger_nodes"
        ],
        "title": "ScenarioPayload"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}