      "post": {
        "tags": [
          "Scenarios & Predictions"
        ],
        "summary": "Run Scenario Sync",
        "description": "Runs a synchronous small-scenario inference and returns a safety certificate.",
        "operationId": "run_scenario_sync_api_v1_scenarios_sync_post",
