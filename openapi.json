          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness Check Api V1 Readiness Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/ingest": {
      "post": {
        "tags": [
          "Ingestion & Snapshots"
        ],
        "summary": "Ingest Event",
        "description": "Ingests versioned sensor/events. Guaranteed idempotent.",
        "operationId": "ingest_event_api_v1_events_ingest_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Ingest Event Api V1 Events Ingest Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/snapshots/materialize": {
      "post": {
        "tags": [
          "Ingestion & Snapshots"
        ],
        "summary": "Materialize Snapshot",
        "description": "Triggers materialization of a new graph snapshot from verified events.",
        "operationId": "materialize_snapshot_api_v1_snapshots_materialize_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "parent_hash",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Parent Hash"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Materialize Snapshot Api V1 Snapshots Materialize Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/register": {
      "post": {
        "tags": [
          "Model Serving"
        ],
        "summary": "Register Model",
        "description": "Registers a model artifact with checksum verification.",
        "operationId": "register_model_api_v1_models_register_post",
